+	// Nest servers can take well over the RTSP response deadline to answer the
+	// first DESCRIBE after GenerateRtspStream while the stream spins up (~8s
+	// when healthy, longer under load). Redial the same session until it is
+	// warm — once ready it answers in well under a second.
+	var rtspClient *rtsp.Conn
+	var lastErr error
+	for attempt := 0; attempt < 6; attempt++ {
+		if attempt > 0 {
+			time.Sleep(time.Second * 2)
+		}
+		rtspClient = rtsp.NewClient(rtspURL)
+		if lastErr = rtspClient.Dial(); lastErr != nil {
