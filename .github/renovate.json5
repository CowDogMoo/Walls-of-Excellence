{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'github>CowDogMoo/renovate-config',
    'github>CowDogMoo/Walls-of-Excellence//.github/renovate/autoMerge.json5',
    'github>CowDogMoo/Walls-of-Excellence//.github/renovate/commitMessage.json5',
    'github>CowDogMoo/Walls-of-Excellence//.github/renovate/labels.json5',
    'github>CowDogMoo/Walls-of-Excellence//.github/renovate/semanticCommits.json5',
  ],
  timezone: 'America/Denver',
  ignorePaths: [
    'kubernetes/deprecated/**',
  ],
  flux: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  'helm-values': {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  kubernetes: {
    managerFilePatterns: [
      '/kubernetes/.+\\.ya?ml$/',
    ],
  },
  customManagers: [
    {
      customType: 'regex',
      description: 'Process custom dependencies',
      managerFilePatterns: [
        '/kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( versioning=(?<versioning>\\S+))?\n.*?"(?<currentValue>.*)"\n',
      ],
      datasourceTemplate: '{{#if datasource}}{{{datasource}}}{{else}}github-releases{{/if}}',
      versioningTemplate: '{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}',
    },
    {
      customType: 'regex',
      description: 'Track the Flux distribution manifests artifact pinned in the FluxInstance',
      managerFilePatterns: [
        '/kubernetes/.+\\.ya?ml$/',
      ],
      matchStrings: [
        'artifact:\\s*oci://(?<depName>ghcr\\.io/controlplaneio-fluxcd/flux-operator-manifests):(?<currentValue>v\\d+\\.\\d+\\.\\d+)',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      description: 'Block k8s-sidecar 1.30.11 due to Python multiprocessing bug',
      matchDatasources: ['docker'],
      matchPackageNames: [
        'ghcr.io/home-operations/k8s-sidecar',
        'kiwigrid/k8s-sidecar',
      ],
      allowedVersions: '!/^1\\.30\\.11$/',
    },
    {
      description: 'Review Flux core upgrades by hand: this artifact picks the Flux version the operator installs, and Flux minors can carry breaking changes',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/controlplaneio-fluxcd/flux-operator-manifests'],
      automerge: false,
    },
    {
      description: 'Merge k3s and system-upgrade-controller updates only in daytime, far from the 02:00-05:00 kured reboot window, so a k3s upgrade never overlaps a kured reboot. Platform automerge is off because GitHub would merge whenever checks pass, outside this schedule',
      matchPackageNames: [
        'k3s-io/k3s',
        'docker.io/rancher/system-upgrade-controller',
      ],
      automergeSchedule: ['* 9-13 * * *'],
      platformAutomerge: false,
    },
  ],
}
